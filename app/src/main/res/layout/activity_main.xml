<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/fondo_claro">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_panel"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/texto_claro"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvEstadoLuz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/estado_luz_apagada"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/estado_apagado"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnInterruptor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_interruptor" />

    <!--
        TODO RAMA feature/contador-luces:
        Insertar aquí un TextView con id 'tvContador' para mostrar
        el total de veces que se ha pulsado el interruptor.
    -->
    <TextView
        android:id="@+id/tvContador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/texto_contador"
        android:textSize="16sp" />

    <!--
        TODO RAMA feature/modo-noche:
        Insertar aquí un Switch con id 'switchModoNoche' para
        alternar el color de fondo de 'layoutRaiz'.
    -->

    <!--
        TODO RAMA feature/boton-panico:
        Insertar aquí un Button rojo con id 'btnPanico' para
        disparar una alerta crítica que posteriormente será revertida con git revert.
    -->

</LinearLayout>
